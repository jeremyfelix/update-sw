#!/bin/bash

set -euo pipefail

MIGRATE_VENVS=
NEW_VERS=
OLD_VERS=
for arg in "$@"; do
    if [[ $arg == "--migrate-venvs" ]]; then
        MIGRATE_VENVS=1
    elif [[ -z $NEW_VERS ]]; then
        NEW_VERS=$arg
    elif [[ -z $OLD_VERS ]]; then
        OLD_VERS=$arg
    fi
done
OLD_VERS=${OLD_VERS:-$(pyenv global | head -n1)}

if [[ $NEW_VERS =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    PYTHON_CONFIGURE_OPTS="--enable-optimizations --with-lto=full" PYTHON_CFLAGS="-march=native -mtune=native" pyenv install -v -f "$NEW_VERS"
else
    pyenv install -v -f "$NEW_VERS"
fi

pyenv migrate "$OLD_VERS" "$NEW_VERS"

mapfile -t globals < <(pyenv global)
new_globals=()
for v in "${globals[@]}"; do
    if [[ $v == "$OLD_VERS" ]]; then
        new_globals+=("$NEW_VERS")
    else
        new_globals+=("$v")
    fi
done
pyenv global "${new_globals[@]}"

if [[ -n $MIGRATE_VENVS ]]; then
    if pyenv commands 2>/dev/null | grep -qx virtualenvs; then
        ROOT=$(pyenv root)
        mapfile -t venv_lines < <(pyenv virtualenvs --bare --skip-aliases | grep "^$OLD_VERS/envs/" || true)
        for line in "${venv_lines[@]}"; do
            name=${line#"$OLD_VERS"/envs/}
            reqs=$("$ROOT/versions/$name/bin/pip" freeze)
            pyenv uninstall -f "$name"
            pyenv virtualenv "$NEW_VERS" "$name"
            printf '%s\n' "$reqs" | "$ROOT/versions/$name/bin/pip" install -r /dev/stdin
            echo "Migrated virtualenv $name -> $NEW_VERS"
        done
    fi
fi

echo "To remove the old version, run:"
echo "pyenv uninstall $OLD_VERS"
