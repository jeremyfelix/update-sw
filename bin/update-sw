#!/usr/bin/env python3

from abc import abstractmethod, ABC
import argparse
import json
import logging
from pathlib import Path
import platform
import subprocess
import sys

from tabulate import tabulate


def create_parser():
    """Create command line parser."""

    description = 'Updates sw on my various platforms'

    parser = argparse.ArgumentParser(description=description)

    parser.add_argument('-p', '--pip-only', action='store_true',
                        help='only update pip packages')
    parser.add_argument('-P', '--pip-bin',
                        help='path to pip binary to use [default: pip3 from '
                        'PATH]')
    parser.add_argument('-s', '--skip-update', action='store_true',
                        help='skip running update command')
    parser.add_argument('-v', '--verbose', action='count',
                        help='Verbose output, repeat for increased verbosity')
    return parser


def parse_args():
    """Parse command line arguments."""

    parser = create_parser()
    args = parser.parse_args()

    return args


def configure_logging(args, use_stdout=False):
    """Set up logging based on command line options."""

    if not args.verbose:
        log_level = logging.WARNING  # Logs calls to logging.warning and above.
    elif args.verbose == 1:
        log_level = logging.INFO     # Logs calls to logging.info and above.
    else:
        log_level = logging.DEBUG    # Logs calls to logging.debug and above.

    stream = sys.stdout if use_stdout else sys.stderr
    logging.basicConfig(level=log_level, format='%(message)s', stream=stream)
    logging.debug(args)


# Runs roughly the following commands:
#   brew update
#   brew outdated
#   brew upgrade
#   brew cleanup
#   pip3 list -o
#   pip3 install -U
#   pip3 check | cut -d ' ' -f1 | xargs pip3 install


class Updater(ABC):
    @property
    def name(self) -> str:
        raise NotImplementedError

    @property
    @abstractmethod
    def update_cmd(self) -> tuple[str, ...]:
        raise NotImplementedError

    @property
    @abstractmethod
    def outdated_cmd(self) -> tuple[str, ...]:
        raise NotImplementedError

    @property
    @abstractmethod
    def upgrade_cmd(self) -> tuple[str, ...]:
        raise NotImplementedError

    @property
    @abstractmethod
    def cleanup_cmd(self) -> tuple[str, ...]:
        raise NotImplementedError

    @property
    def update_banner(self) -> str:
        return f'Updating ({self.name})...'

    @property
    def outdated_banner(self) -> str:
        return f'Outdated ({self.name}):'

    @property
    def upgrade_prompt(self) -> str:
        return f'Run upgrade ({self.name})? [Y/n]: '

    @property
    def cleanup_banner(self) -> str:
        return f'Running cleanup ({self.name})...'

    def update(self):
        if not self.update_cmd:
            return
        print(self.update_banner)
        logging.debug(self.update_cmd)
        subprocess.run(self.update_cmd, check=True)

    def outdated(self):
        if not self.outdated_cmd:
            return
        print(self.outdated_banner)
        logging.debug(self.outdated_cmd)
        subprocess.run(self.outdated_cmd, check=True)

    def upgrade(self):
        if not self.upgrade_cmd:
            return
        reply = input(self.upgrade_prompt)
        if reply not in ('N', 'n'):
            logging.debug(self.upgrade_cmd)
            subprocess.run(self.upgrade_cmd, check=True)

    def cleanup(self):
        if not self.cleanup_cmd:
            return
        print(self.cleanup_banner)
        logging.debug(self.cleanup_cmd)
        subprocess.run(self.cleanup_cmd, check=True)

    def run(self, skip_update: bool = False):
        if not skip_update:
            self.update()
            print()
        self.outdated()
        print()
        self.upgrade()
        print()
        self.cleanup()


class BrewUpdater(Updater):
    @property
    def name(self) -> str:
        return 'brew'

    @property
    def update_cmd(self) -> tuple[str, ...]:
        return ('brew', 'update')

    @property
    def outdated_cmd(self) -> tuple[str, ...]:
        return ('brew', 'outdated')

    @property
    def upgrade_cmd(self) -> tuple[str, ...]:
        return ('brew', 'upgrade')

    @property
    def cleanup_cmd(self) -> tuple[str, ...]:
        return ('brew', 'cleanup')


class AptUpdater(Updater):
    @property
    def name(self) -> str:
        return 'apt'

    @property
    def update_cmd(self) -> tuple[str, ...]:
        return ('sudo', '/usr/bin/apt', 'update')

    @property
    def outdated_cmd(self) -> tuple[str, ...]:
        return ('/usr/bin/apt', 'list', '--upgradeable')

    @property
    def upgrade_cmd(self) -> tuple[str, ...]:
        return ('sudo', '/usr/bin/apt', 'upgrade')

    @property
    def cleanup_cmd(self) -> tuple[str, ...]:
        return ('sudo', '/usr/bin/apt', 'autoremove')


class EmergeUpdater(Updater):
    @property
    def name(self) -> str:
        return 'emerge'

    @property
    def update_cmd(self) -> tuple[str, ...]:
        return ('sudo', '/usr/bin/nice', '/usr/bin/eix-sync')

    @property
    def outdated_cmd(self) -> tuple[str, ...]:
        return ()

    @property
    def upgrade_cmd(self) -> tuple[str, ...]:
        return ('ntfy', 'done', '-L', '60', 'sudo', '/usr/bin/nice',
                '/usr/bin/emerge', '-avuUD', '@world')

    @property
    def cleanup_cmd(self) -> tuple[str, ...]:
        return ('sudo', '/usr/bin/nice', '/usr/bin/emerge', '-av',
                '--depclean')


class PipUpdater(Updater):
    PIP_SKIP = ('inventory', 'utils')

    def __init__(self, pip_path: str | Path | None = 'pip3'):
        self.pip = pip_path if pip_path is not None else 'pip3'
        self._to_update: list[str] = []

    @property
    def name(self) -> str:
        return 'pip'

    @property
    def update_cmd(self) -> tuple[str, ...]:
        return ()

    @property
    def outdated_cmd(self) -> tuple[str, ...]:
        return ()

    @property
    def upgrade_cmd(self) -> tuple[str, ...]:
        return ()

    @property
    def cleanup_cmd(self) -> tuple[str, ...]:
        return ()

    def outdated(self):
        print(self.outdated_banner)
        outdated = json.loads(
            subprocess.run((self.pip, 'list', '-o', '--format', 'json'),
                           check=True, stdout=subprocess.PIPE,
                           encoding='utf8').stdout)
        to_update = []
        for package in outdated:
            name = package['name']
            if name in self.PIP_SKIP:
                print('Skipping {name}'.format_map(package))
            else:
                to_update.append(
                    (name, package['version'], package['latest_version']))

        if to_update:
            print(tabulate([('Package', 'Version', 'Latest')] + to_update,
                           headers='firstrow'))
            self._to_update = [row[0] for row in to_update]

    def upgrade(self):
        if not self._to_update:
            return
        reply = input(self.upgrade_prompt)
        if reply in ('N', 'n'):
            return
        logging.debug([self.pip, 'install', '-U'] + self._to_update)
        subprocess.run([self.pip, 'install', '-U'] + self._to_update,
                       check=True)
        result = subprocess.run((self.pip, 'check'), stdout=subprocess.PIPE,
                                encoding='utf8', check=False)
        if result.returncode != 0:
            to_fix = [row.split(maxsplit=1)[0]
                      for row in result.stdout.splitlines()]
            print('Fixing broken pip dependencies')
            print(f'{self.pip} install {" ".join(to_fix)}')
            subprocess.run([self.pip, 'install'] + to_fix, check=True)


def update_sw(skip_update: bool):
    match platform.system():
        case 'Darwin':
            BrewUpdater().run(skip_update)
        case 'Linux':
            import distro  # type: ignore
            # If Linux, check if for ubuntu vs. gentoo.
            match distro.id():
                case 'gentoo':
                    pass
                    EmergeUpdater().run(skip_update)
                case 'rasbian' | 'ubuntu':
                    AptUpdater().run(skip_update)


def main():
    args = parse_args()
    configure_logging(args)

    try:
        if not args.pip_only:
            update_sw(args.skip_update)
        PipUpdater(args.pip_bin).run()
    except subprocess.CalledProcessError as ex:
        print(ex, file=sys.stderr)
        return ex.returncode

    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(1)
