#!/usr/bin/env python3

import json
import subprocess
import sys

from tabulate import tabulate

# Runs the following commands:
#   brew update
#   brew outdated
#   brew upgrade --build-from-source
#   brew cleanup
#   pip3 list -o
#   pip3 install -U
#   pip3 check | cut -d ' ' -f1 | xargs pip3 install -U


PIP_SKIP = ('inventory', 'utils')


def update_sw():
    print('Updating brew...')
    subprocess.run(('brew', 'update'), check=True)

    print('\nbrew outdated:')
    subprocess.run(('brew', 'outdated'), check=True)

    reply = input('\nRun brew upgrade? [Y/n]: ')
    if reply not in ('N', 'n'):
        subprocess.run(('brew', 'upgrade', '--build-from-source'), check=True)

    print('\nRunning brew cleanup...')
    subprocess.run(('brew', 'cleanup'), check=True)

    print('\npip3 list -o:')
    outdated = json.loads(
        subprocess.run(('pip3', 'list', '-o', '--format', 'json'), check=True,
                       stdout=subprocess.PIPE, encoding='utf8').stdout)
    to_update = []
    for package in outdated:
        name = package['name']
        if name in PIP_SKIP:
            print('Skipping {name}'.format_map(package))
        else:
            to_update.append(
                (name, package['version'], package['latest_version']))

    if to_update:
        print(tabulate([('Package', 'Version', 'Latest')] + to_update,
                       headers='firstrow'))
        to_update = [row[0] for row in to_update]
        reply = input('\nRun pip3 install -U {}? [Y/n]: '.format(
            ' '.join(to_update)))
        if reply not in ('N', 'n'):
            subprocess.run(['pip3', 'install', '-U'] + to_update, check=True)
            result = subprocess.run(('pip3', 'check'), stdout=subprocess.PIPE,
                                    encoding='utf8', check=False)
            if result.returncode != 0:
                to_fix = [row.split(maxsplit=1)[0]
                          for row in result.stdout.splitlines()]
                print('Fixing broken pip dependencies')
                print(f'pip3 install -U {" ".join(to_fix)}')
                subprocess.run(['pip3', 'install', '-U'] + to_fix, check=True)


def main():
    try:
        update_sw()
    except subprocess.CalledProcessError as ex:
        print(ex, file=sys.stderr)
        return ex.returncode


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(1)
