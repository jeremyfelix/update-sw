#!/usr/bin/env python3

from abc import abstractmethod, ABC
import argparse
from collections.abc import Sequence
import getpass
import json
import logging
from pathlib import Path
import platform
import re
from io import StringIO
import shutil
import subprocess
import sys
from typing import cast, TextIO

from tabulate import tabulate


def create_parser():
    """Create command line parser."""

    description = 'Updates sw on my various platforms'

    parser = argparse.ArgumentParser(description=description)

    parser.add_argument('-p', '--pip-only', action='store_true',
                        help='only update pip packages')
    parser.add_argument('-P', '--pip-bin',
                        help='path to pip binary to use [default: pip3 from '
                        'PATH]')
    parser.add_argument('-s', '--skip-update', action='store_true',
                        help='skip running update command')
    parser.add_argument('-S', '--skip-system-updater', action='store_true',
                        help='skip running system update ui')
    parser.add_argument('-A', '--skip-appstore-updater', action='store_true',
                        help='skip running appstore ui')
    parser.add_argument('-v', '--verbose', action='count',
                        help='verbose output, repeat for increased verbosity')
    return parser


def parse_args():
    """Parse command line arguments."""

    parser = create_parser()
    args = parser.parse_args()

    return args


def configure_logging(args, use_stdout=False):
    """Set up logging based on command line options."""

    if not args.verbose:
        log_level = logging.WARNING  # Logs calls to logging.warning and above.
    elif args.verbose == 1:
        log_level = logging.INFO     # Logs calls to logging.info and above.
    else:
        log_level = logging.DEBUG    # Logs calls to logging.debug and above.

    stream = sys.stdout if use_stdout else sys.stderr
    logging.basicConfig(level=log_level, format='%(message)s', stream=stream)
    logging.debug(args)


# Runs roughly the following commands:
#   brew update
#   brew outdated
#   brew upgrade
#   brew cleanup
#   pip3 list -o
#   pip3 install -U
#   pip3 check | cut -d ' ' -f1 | xargs pip3 install


class Updater(ABC):
    @property
    def name(self) -> str:
        raise NotImplementedError

    @property
    def update_banner(self) -> str:
        return f'Updating ({self.name})...'

    @property
    def outdated_banner(self) -> str:
        return f'Outdated ({self.name}):'

    @property
    def upgrade_prompt(self) -> str:
        return f'Run upgrade ({self.name})? [Y/n]: '

    @property
    def cleanup_banner(self) -> str:
        return f'Running cleanup ({self.name})...'

    @abstractmethod
    def _update(self):
        raise NotImplementedError

    @abstractmethod
    def _outdated(self):
        raise NotImplementedError

    @abstractmethod
    def _upgrade(self):
        raise NotImplementedError

    @abstractmethod
    def _cleanup(self):
        raise NotImplementedError

    def update(self):
        print(self.update_banner)
        self._update()
        print()

    def outdated(self):
        print(self.outdated_banner)
        self._outdated()
        print()

    def upgrade(self):
        reply = input(self.upgrade_prompt)
        if reply not in ('N', 'n'):
            self._upgrade()
        print()

    def cleanup(self):
        print(self.cleanup_banner)
        self._cleanup()
        print()

    def run(self, skip_update: bool = False):
        if not skip_update:
            self.update()
        self.outdated()
        self.upgrade()
        self.cleanup()


class CommandBasedUpdater(Updater):
    @staticmethod
    def _run_with_output(args: Sequence[str]) -> str:
        with (subprocess.Popen(args, stdout=subprocess.PIPE, bufsize=1,
                               encoding='utf8', text=True) as p,
              StringIO() as buf):
            for line in cast(TextIO, p.stdout):
                print(line, end='')
                buf.write(line)
            output = buf.getvalue()
            if p.wait() != 0:
                raise subprocess.CalledProcessError(p.returncode, args, output)
            return output

    @staticmethod
    def _run(args: Sequence[str]):
        logging.debug(args)
        subprocess.run(args, check=True)

    @property
    @abstractmethod
    def update_cmd(self) -> tuple[str, ...]:
        raise NotImplementedError

    @property
    @abstractmethod
    def outdated_cmd(self) -> tuple[str, ...]:
        raise NotImplementedError

    @property
    def has_updates(self) -> bool:
        # Override and parse self.outdated_output to skip upgrade
        return True

    @property
    @abstractmethod
    def upgrade_cmd(self) -> tuple[str, ...]:
        raise NotImplementedError

    @property
    @abstractmethod
    def cleanup_cmd(self) -> tuple[str, ...]:
        raise NotImplementedError

    def _update(self):
        self._run(self.update_cmd)

    def _outdated(self):
        self.outdated_output = self._run_with_output(self.outdated_cmd)

    def _upgrade(self):
        self._run(self.upgrade_cmd)

    def _cleanup(self):
        self._run(self.cleanup_cmd)

    def update(self):
        if not self.update_cmd:
            return
        super().update()

    def outdated(self):
        if not self.outdated_cmd:
            return
        super().outdated()

    def upgrade(self):
        if not self.upgrade_cmd:
            return
        if self.has_updates:
            super().upgrade()

    def cleanup(self):
        if not self.cleanup_cmd:
            return
        super().cleanup()


class BrewUpdater(CommandBasedUpdater):
    @property
    def name(self) -> str:
        return 'brew'

    @property
    def update_cmd(self) -> tuple[str, ...]:
        return ('brew', 'update')

    @property
    def outdated_cmd(self) -> tuple[str, ...]:
        return ('brew', 'outdated', '--fetch-HEAD')

    @property
    def has_updates(self) -> bool:
        return self.outdated_output != ''

    @property
    def upgrade_cmd(self) -> tuple[str, ...]:
        return ('brew', 'upgrade', '--fetch-HEAD')

    @property
    def cleanup_cmd(self) -> tuple[str, ...]:
        return ('brew', 'cleanup')


class AptUpdater(CommandBasedUpdater):
    @property
    def name(self) -> str:
        return 'apt'

    @property
    def update_cmd(self) -> tuple[str, ...]:
        return ('sudo', '/usr/bin/apt', 'update')

    @property
    def outdated_cmd(self) -> tuple[str, ...]:
        return ('/usr/bin/apt', 'list', '--upgradeable')

    @property
    def has_updates(self) -> bool:
        return self.outdated_output != 'Listing...\n'

    @property
    def upgrade_cmd(self) -> tuple[str, ...]:
        return ('sudo', '/usr/bin/apt', 'upgrade')

    @property
    def cleanup_cmd(self) -> tuple[str, ...]:
        return ('sudo', '/usr/bin/apt', 'autoremove')


class EmergeUpdater(CommandBasedUpdater):
    @property
    def name(self) -> str:
        return 'emerge'

    @property
    def update_cmd(self) -> tuple[str, ...]:
        return ('sudo', '/usr/bin/nice', '/usr/bin/eix-sync')

    @property
    def outdated_cmd(self) -> tuple[str, ...]:
        return ()

    @property
    def upgrade_cmd(self) -> tuple[str, ...]:
        return ('ntfy', 'done', '-L', '60', 'sudo', '/usr/bin/nice',
                '/usr/bin/emerge', '-avuUD', '@world')

    @property
    def cleanup_cmd(self) -> tuple[str, ...]:
        return ('sudo', '/usr/bin/nice', '/usr/bin/emerge', '-av',
                '--depclean')


class PipUpdater(Updater):
    PIP_SKIP = ('inventory', 'utils')

    def __init__(self, pip_path: str | Path | None = None):
        self.pip = shutil.which(pip_path if pip_path is not None else 'pip3')
        if self.pip is None:
            raise ValueError(pip_path)
        self._to_update: list[str] = []

    @property
    def name(self) -> str:
        return 'pip'

    def run(self, skip_update: bool = False):
        owner = Path(cast(str | Path, self.pip)).owner()
        us = getpass.getuser()
        if owner != us:
            print(f'Skipping python (owner: {owner}) that is not ours ({us})')
            return
        super().run(skip_update)

    def update(self):
        pass

    def cleanup(self):
        pass

    def _update(self):
        pass

    def _cleanup(self):
        pass

    def upgrade(self):
        if not self._to_update:
            return
        super().upgrade()

    def _outdated(self):
        outdated = json.loads(
            subprocess.run((str(self.pip), 'list', '-o', '--format', 'json'),
                           check=True, stdout=subprocess.PIPE,
                           encoding='utf8').stdout)
        to_update = []
        for package in outdated:
            name = package['name']
            if name in self.PIP_SKIP:
                print('Skipping {name}'.format_map(package))
            else:
                to_update.append(
                    (name, package['version'], package['latest_version']))

        if to_update:
            print(tabulate([('Package', 'Version', 'Latest')] + to_update,
                           headers='firstrow'))
            self._to_update = [row[0] for row in to_update]

    def _upgrade(self):
        if not self._to_update:
            return
        logging.debug([self.pip, 'install', '-U'] + self._to_update)
        subprocess.run([self.pip, 'install', '-U'] + self._to_update,
                       check=True)
        result = subprocess.run((str(self.pip), 'check'),
                                stdout=subprocess.PIPE, encoding='utf8',
                                check=False)
        if result.returncode != 0:
            to_fix = [row.split(maxsplit=1)[0]
                      for row in result.stdout.splitlines()]
            print('Fixing broken pip dependencies')
            print(f'{self.pip} install {" ".join(to_fix)}')
            subprocess.run([self.pip, 'install'] + to_fix, check=True)


class PyenvUpdater(CommandBasedUpdater):
    def __init__(self):
        self._latest: tuple[int, int, int] | None = None

    @property
    def name(self) -> str:
        return 'pyenv'

    @staticmethod
    def has_pyenv() -> bool:
        try:
            subprocess.run(('pyenv', '--version'), check=True,
                           stdout=subprocess.DEVNULL)
            return True
        except (FileNotFoundError, subprocess.CalledProcessError):
            return False

    @property
    def has_update(self) -> bool:
        """Determines if pyenv update command is available"""
        commands = subprocess.run(('pyenv', 'commands', '-h'), check=True,
                                  capture_output=True, encoding='utf8').stdout
        return 'update' in commands.splitlines()

    @property
    def update_cmd(self) -> tuple[str, ...]:
        if not self.has_update:
            return ()
        return ('pyenv', 'update')

    @property
    def outdated_cmd(self) -> tuple[str, ...]:
        return ('false',)

    def _parse_version(self, ver_str: str) -> tuple[int, int, int]:
        vers_re = r'\b(\d+)\.(\d+)\.(\d+)\b'
        match = re.match(vers_re, ver_str)
        if not match:
            raise ValueError(f'"{ver_str}" does not match expected format')
        return (int(match.group(1)), int(match.group(2)), int(match.group(3)))

    def _outdated(self):
        current = subprocess.run(
            ('pyenv', 'version-name'), check=True, capture_output=True,
            encoding='utf8').stdout.strip()
        available = subprocess.run(('pyenv', 'install', '--list'), check=True,
                                   capture_output=True, encoding='utf8').stdout
        cur_ver = self._parse_version(current)
        avail_vers = []
        for avail in available.splitlines():
            try:
                avail_ver = self._parse_version(avail.strip())
            except ValueError:
                continue
            if avail_ver > cur_ver:
                avail_vers.append(avail_ver)

        if avail_vers:
            latest = sorted(avail_vers)[-1]
            print('Current version:', '.'.join(map(str, cur_ver)))
            print('Latest version:', '.'.join(map(str, latest)))
            self._latest = latest

    @property
    def upgrade_cmd(self) -> tuple[str, ...]:
        if not self._latest:
            return ()
        return ('update-python', '.'.join(map(str, self._latest)))

    @property
    def cleanup_cmd(self) -> tuple[str, ...]:
        return ()


class MacOsUpdater(CommandBasedUpdater):
    @property
    def name(self) -> str:
        return 'macos'

    @property
    def update_cmd(self) -> tuple[str, ...]:
        return ()

    @property
    def outdated_cmd(self) -> tuple[str, ...]:
        return ('softwareupdate', '--list')

    @property
    def has_updates(self) -> bool:
        return not self.outdated_output.endswith(
            'Finding available software\n')

    @property
    def upgrade_cmd(self) -> tuple[str, ...]:
        return ('sudo', 'softwareupdate', '--install', '--all', '--restart')

    @property
    def cleanup_cmd(self) -> tuple[str, ...]:
        return ()


class RustupUpdater(CommandBasedUpdater):
    @staticmethod
    def has_rustup() -> bool:
        try:
            subprocess.run(('rustup', '--version'), check=True,
                           stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
            return True
        except (FileNotFoundError, subprocess.CalledProcessError):
            return False

    @property
    def name(self) -> str:
        return 'rustup'

    @property
    def update_cmd(self) -> tuple[str, ...]:
        return ('rustup', 'self', 'update')

    @property
    def outdated_cmd(self) -> tuple[str, ...]:
        return ('rustup', 'check')

    @property
    def upgrade_cmd(self) -> tuple[str, ...]:
        return ('rustup', 'update')

    @property
    def cleanup_cmd(self) -> tuple[str, ...]:
        return ()

    @property
    def has_updates(self) -> bool:
        return re.search('Update available', self.outdated_output) is not None


def update_sw(skip_update: bool, skip_system_updater: bool,
              skip_appstore_updater: bool):
    match platform.system():
        case 'Darwin':
            if not skip_system_updater:
                MacOsUpdater().run()
            BrewUpdater().run(skip_update)
        case 'Linux':
            import distro  # type: ignore
            # If Linux, check if for ubuntu vs. gentoo.
            match distro.id():
                case 'gentoo':
                    if not skip_system_updater:
                        EmergeUpdater().run(skip_update)
                case 'rasbian':
                    AptUpdater().run(skip_update)
                case 'ubuntu':
                    if 'microsoft-standard-WSL' in platform.uname().release:
                        if not skip_system_updater:
                            subprocess.run(['explorer.exe',
                                            'ms-settings:windowsupdate'])
                        if not skip_appstore_updater:
                            subprocess.run(['explorer.exe',
                                           'ms-windows-store:'])
                    AptUpdater().run(skip_update)


def main():
    args = parse_args()
    configure_logging(args)

    try:
        if not args.pip_only:
            update_sw(args.skip_update, args.skip_system_updater,
                      args.skip_appstore_updater)
        PipUpdater(args.pip_bin).run()
        if not args.pip_only:
            if PyenvUpdater.has_pyenv():
                PyenvUpdater().run()
            if RustupUpdater.has_rustup():
                RustupUpdater().run()
    except subprocess.CalledProcessError as ex:
        print(ex, file=sys.stderr)
        return ex.returncode

    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(1)
