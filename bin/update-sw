#!/usr/bin/env python3

import argparse
import json
import logging
import platform
import subprocess
import sys

from tabulate import tabulate


def create_parser():
    """Create command line parser."""

    description = 'Updates sw on my various platforms'

    parser = argparse.ArgumentParser(description=description)

    parser.add_argument('-p', '--pip-only', action='store_true',
                        help='only update pip packages')
    parser.add_argument('-P', '--pip-bin',
                        help='path to pip binary to use [default: pip3 from '
                        'PATH]')
    parser.add_argument('-v', '--verbose', action='count',
                        help='Verbose output, repeat for increased verbosity')
    return parser


def parse_args():
    """Parse command line arguments."""

    parser = create_parser()
    args = parser.parse_args()

    return args


def configure_logging(args, use_stdout=False):
    """Set up logging based on command line options."""

    if not args.verbose:
        log_level = logging.WARNING  # Logs calls to logging.warning and above.
    elif args.verbose == 1:
        log_level = logging.INFO     # Logs calls to logging.info and above.
    else:
        log_level = logging.DEBUG    # Logs calls to logging.debug and above.

    stream = sys.stdout if use_stdout else sys.stderr
    logging.basicConfig(level=log_level, format='%(message)s', stream=stream)
    logging.debug(args)

# Runs the following commands:
#   brew update
#   brew outdated
#   brew upgrade
#   brew cleanup
#   pip3 list -o
#   pip3 install -U
#   pip3 check | cut -d ' ' -f1 | xargs pip3 install


PIP_SKIP = ('inventory', 'utils')


def update_brew():
    print('Updating brew...')
    subprocess.run(('brew', 'update'), check=True)

    print('\nbrew outdated:')
    subprocess.run(('brew', 'outdated'), check=True)

    reply = input('\nRun brew upgrade? [Y/n]: ')
    if reply not in ('N', 'n'):
        subprocess.run(('brew', 'upgrade'), check=True)

    print('\nRunning brew cleanup...')
    subprocess.run(('brew', 'cleanup'), check=True)


def update_pip(pip: str | None = 'pip3'):
    if pip is None:
        pip = 'pip3'
    print(f'\n{pip} list -o:')
    outdated = json.loads(
        subprocess.run((pip, 'list', '-o', '--format', 'json'), check=True,
                       stdout=subprocess.PIPE, encoding='utf8').stdout)
    to_update = []
    for package in outdated:
        name = package['name']
        if name in PIP_SKIP:
            print('Skipping {name}'.format_map(package))
        else:
            to_update.append(
                (name, package['version'], package['latest_version']))

    if to_update:
        print(tabulate([('Package', 'Version', 'Latest')] + to_update,
                       headers='firstrow'))
        to_update = [row[0] for row in to_update]
        reply = input(f'\nRun {pip} install -U {" ".join(to_update)}')
        if reply not in ('N', 'n'):
            subprocess.run([pip, 'install', '-U'] + to_update, check=True)
            result = subprocess.run((pip, 'check'), stdout=subprocess.PIPE,
                                    encoding='utf8', check=False)
            if result.returncode != 0:
                to_fix = [row.split(maxsplit=1)[0]
                          for row in result.stdout.splitlines()]
                print('Fixing broken pip dependencies')
                print(f'{pip} install {" ".join(to_fix)}')
                subprocess.run([pip, 'install'] + to_fix, check=True)


def update_sw():
    if platform.system() == 'Darwin':
        update_brew()
    # If Linux, check if for ubuntu vs. gentoo.


def main():
    args = parse_args()
    configure_logging(args)

    try:
        if not args.pip_only:
            update_sw()
        update_pip(args.pip_bin)
    except subprocess.CalledProcessError as ex:
        print(ex, file=sys.stderr)
        return ex.returncode

    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(1)
