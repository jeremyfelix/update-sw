#!/usr/bin/env python3

"""Updates sw on my various platforms.

Each kind of software is handled by an Updater: a class with up to four
optional steps (update, outdated, upgrade, cleanup).  A step an updater does
not implement is skipped without printing anything.  Updaters register
themselves by name when their class is defined, and ORDER says which order
they run in.

Configuration
-------------

An optional TOML file, ${XDG_CONFIG_HOME:-~/.config}/update-sw/config.toml
(or the file given with --config), adjusts what runs.  Every key is
optional.  See examples/config.toml in this repo for commentary.

    # Replace the computed default list entirely (kept in the order given)
    default = ['brew', 'pip']
    exclude = []    # names removed from the default list
    extra = []      # names added to the default list

    [pip]
    skip = ['inventory', 'utils']   # packages pip never upgrades

    [brew]
    fetch_head = true   # add --fetch-HEAD to outdated and upgrade

    [cargo]
    git = true          # add --git to --list and upgrade

    # Simple updaters defined entirely in config.  `update`, `outdated`,
    # `upgrade` and `cleanup` are commands (lists of arguments); omit a step
    # to skip it.  Output of `outdated` that is empty (or equal to
    # `no_updates_output`, ignoring surrounding whitespace) means there is
    # nothing to upgrade.  `requires` is an executable that must be on PATH,
    # and `default` includes the updater in the default list when it is
    # available.  `outdated_ok_returncodes` and `update_is_fatal` behave as
    # they do on CommandBasedUpdater.
    [updaters.flatpak]
    update = []
    outdated = ['flatpak', 'remote-ls', '--updates']
    upgrade = ['flatpak', 'update']
    cleanup = ['flatpak', 'uninstall', '--unused']
    no_updates_output = ''
    requires = 'flatpak'
    default = true

Plugins
-------

Every *.py file in ${XDG_CONFIG_HOME:-~/.config}/update-sw/updaters/ is
loaded, in sorted order, after the built-in and config-defined updaters.
This script is importable from them as `update_sw`, and subclassing Updater
(or CommandBasedUpdater) registers the new updater by its `name`.  A plugin
that fails to load is reported and skipped.  Plugin updaters are part of the
default list, after the built-in ones, when they apply and are available;
set `default = False` to run one only by name.  For example:

    from update_sw import CommandBasedUpdater

    class SnapUpdater(CommandBasedUpdater):
        name = 'snap'
        requires = 'snap'
        outdated_cmd = ('snap', 'refresh', '--list')
        upgrade_cmd = ('sudo', 'snap', 'refresh')

        def has_updates(self, output):
            return 'All snaps up to date' not in output
"""

import argparse
import getpass
import importlib.util
import json
import logging
import os
import platform
import re
import shlex
import shutil
import subprocess
import sys
from collections.abc import Callable, Iterable, Sequence
from dataclasses import dataclass
from functools import cache, cached_property
from io import StringIO
from pathlib import Path
from typing import Any, TextIO, TypeVar, cast

try:
    import tomllib
except ImportError:  # Python < 3.11
    tomllib = None  # type: ignore

from tabulate import tabulate

T = TypeVar('T')


class VersionAction(argparse.Action):
    """Print the version and exit.

    Unlike action='version', the version is looked up only when the flag is
    given, so building the parser does not run git on every invocation.
    """

    def __init__(self, option_strings, dest=argparse.SUPPRESS, **kwargs):
        super().__init__(option_strings, dest, nargs=0, **kwargs)

    def __call__(self, parser, namespace, values, option_string=None):
        print(f'update-sw {version()}')
        parser.exit()


def create_parser():
    """Create command line parser."""

    description = 'Updates sw on my various platforms'

    parser = argparse.ArgumentParser(description=description)

    parser.add_argument(
        'updaters',
        nargs='*',
        help='updaters to run, by name [default: platform default set]',
    )
    parser.add_argument(
        '-P',
        '--pip-bin',
        help='path to pip binary to use [default: pip3 from PATH]',
    )
    parser.add_argument(
        '-s',
        '--skip-update',
        action='store_true',
        help='skip running update command',
    )
    parser.add_argument(
        '-c',
        '--config',
        type=Path,
        help='config file to use '
        '[default: ${XDG_CONFIG_HOME:-~/.config}/update-sw/config.toml]',
    )
    parser.add_argument(
        '-x',
        '--exclude',
        action='append',
        default=[],
        metavar='NAME',
        help='do not run this updater, repeat for more than one',
    )
    parser.add_argument(
        '-y',
        '--yes',
        action='store_true',
        help='answer yes to every [Y/n] prompt (and pick the default '
        'target when moving virtualenvs) instead of asking',
    )
    parser.add_argument(
        '-n',
        '--dry-run',
        action='store_true',
        help='print "would run: ..." instead of running commands that change '
        'anything (update, upgrade, cleanup, update-python, update-venv); '
        'read-only queries (outdated, pip list, pyenv versions) still run',
    )
    parser.add_argument(
        '--list',
        action='store_true',
        help='list known updater names and exit',
    )
    parser.add_argument(
        '-v',
        '--verbose',
        action='count',
        help='verbose output, repeat for increased verbosity',
    )
    parser.add_argument(
        '-V',
        '--version',
        action=VersionAction,
        help='show the version (from git tags) and exit',
    )
    return parser


def parse_args(argv: Sequence[str] | None = None):
    """Parse command line arguments."""

    parser = create_parser()
    args = parser.parse_args(argv)

    return args


def configure_logging(args, use_stdout=False):
    """Set up logging based on command line options."""

    if not args.verbose:
        log_level = logging.WARNING  # Logs calls to logging.warning and above.
    elif args.verbose == 1:
        log_level = logging.INFO  # Logs calls to logging.info and above.
    else:
        log_level = logging.DEBUG  # Logs calls to logging.debug and above.

    stream = sys.stdout if use_stdout else sys.stderr
    logging.basicConfig(level=log_level, format='%(message)s', stream=stream)
    logging.debug(args)


@dataclass
class Settings:
    """Run-wide switches, set once from the command line."""

    yes: bool = False
    dry_run: bool = False


# A plain module-level setting: threading it through every updater would only
# add arguments that nothing but confirm() and _run() ever look at.
SETTINGS = Settings()


def confirm(prompt: str) -> bool:
    """Ask a yes-by-default question; only an explicit n/N says no."""

    if SETTINGS.yes:
        # Echo the answer so a log of an unattended run still reads sensibly.
        print(f'{prompt}y')
        return True
    return input(prompt) not in ('N', 'n')


class UpdaterError(Exception):
    """One or more items of an updater failed (and were already reported)."""

    def __init__(self, failed: Sequence[str]):
        super().__init__(f'failed: {", ".join(failed)}')
        self.failed = list(failed)


class Restart(Exception):
    """The script was replaced; re-run it so the rest uses the new code."""


def run_each(
    items: Iterable[T],
    fn: Callable[[T], object],
    label_of: Callable[[T], str],
    catch: tuple[type[Exception], ...] = (subprocess.CalledProcessError,),
) -> None:
    """Call fn on every item, then raise UpdaterError if any of them failed.

    One bad item should not cost the user the others, so each failure is
    reported as it happens and only raised once everything has had its turn.
    """

    failed: list[str] = []
    for item in items:
        try:
            fn(item)
        except catch as ex:
            label = label_of(item)
            print(f'{label}: {ex}', file=sys.stderr)
            failed.append(label)
    if failed:
        raise UpdaterError(failed)


# Platform facts.  Cached because they cannot change mid-run and several
# updaters ask.


@cache
def is_darwin() -> bool:
    return platform.system() == 'Darwin'


@cache
def linux_distro() -> str:
    """The distro id (`ubuntu`, `gentoo`, ...), or '' if not on Linux."""

    if platform.system() != 'Linux':
        return ''
    try:
        import distro  # type: ignore
    except ImportError:
        return ''
    return distro.id()


@cache
def is_wsl() -> bool:
    return (
        platform.system() == 'Linux'
        and 'microsoft-standard-WSL' in platform.uname().release
    )


@cache
def command_succeeds(*args: str) -> bool:
    """Whether running `args` works, i.e. the tool is installed and sane."""

    try:
        subprocess.run(
            args,
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        return True
    except (FileNotFoundError, subprocess.CalledProcessError):
        return False


def describe(*args: str) -> str:
    """`git describe --tags --always` in the clone this script runs from.

    Raises FileNotFoundError (no git) or CalledProcessError (not a clone).
    """

    return subprocess.run(
        [
            'git',
            '-C',
            str(SelfUpdater.repo_dir()),
            'describe',
            '--tags',
            '--always',
            *args,
        ],
        capture_output=True,
        check=True,
        encoding='utf8',
    ).stdout.strip()


@cache
def version() -> str:
    """The version from git tags, e.g. v1.0.0-3-g22b5d76, or 'unknown'."""

    try:
        return describe('--dirty')
    except (FileNotFoundError, subprocess.CalledProcessError):
        return 'unknown'


# name -> class for every concrete Updater, filled in as classes are defined.
REGISTRY: dict[str, type['Updater']] = {}

# The order updaters run in, wherever they apply.  Updaters that are not
# listed (from config or plugins) run after these, in registration order.
ORDER: list[str] = [
    # First, so that everything after it runs the new code: a restart re-runs
    # whatever ran before it.
    'self',
    'windows-update',
    'windows-store',
    'macos',
    'brew',
    # After brew, which is what installs and upgrades mas itself.
    'mas',
    'apt',
    'emerge',
    'pip',
    'pyenv',
    # After pyenv, so a virtualenv whose base was just upgraded is already
    # dealt with and only genuine stragglers are left to report.
    'venv',
    'rustup',
    # After rustup, so anything rebuilt from source uses the toolchain that
    # was just updated.
    'cargo',
]


def list_names() -> list[str]:
    """Every registered updater name, in ORDER and then registration order."""

    return [n for n in ORDER if n in REGISTRY] + [
        n for n in REGISTRY if n not in ORDER
    ]


# Runs roughly the following commands:
#   brew update
#   brew outdated
#   brew upgrade
#   brew cleanup
#   pip3 list -o
#   pip3 install -U
#   pip3 check | cut -d ' ' -f1 | xargs pip3 install


class Updater:
    """Base class for everything update-sw can update.

    Subclasses are registered by `name` when defined.  Implement any of
    _update, _outdated, _upgrade and _cleanup; the ones left alone are
    skipped silently.  Set `abstract = True` on a class that only exists to
    be subclassed.
    """

    name: str = ''
    # Whether the default set includes this updater (when it applies and is
    # available); it can always be requested by name.
    default = True
    # What the outdated step found, for has_updates-style decisions.
    outdated_output: str = ''

    def __init_subclass__(cls, **kwargs):
        super().__init_subclass__(**kwargs)
        # Looked up in the class's own namespace so that `abstract` is not
        # inherited: a subclass of an abstract helper is concrete.
        if cls.__dict__.get('abstract', False):
            return
        if not cls.name:
            raise ValueError(f'{cls.__name__} has no name')
        if cls.name in REGISTRY:
            raise ValueError(f'updater {cls.name!r} is already registered')
        REGISTRY[cls.name] = cls

    @classmethod
    def from_args(
        cls, args: argparse.Namespace, config: dict[str, Any]
    ) -> 'Updater':
        """Build an updater from the command line and its config section."""

        return cls()

    @classmethod
    def applies(cls) -> bool:
        """Whether this updater makes sense on this platform at all."""

        return True

    @classmethod
    def available(cls) -> bool:
        """Whether what this updater drives is installed and usable."""

        return True

    @classmethod
    def missing_hint(cls) -> str | None:
        """Say what is missing, or None if this updater can run."""

        if cls.available():
            return None
        return f'{cls.name} is not available on this system.'

    @staticmethod
    def _run(args: Sequence[str], check: bool = True):
        """Run a command that changes things, so honor --dry-run."""

        if SETTINGS.dry_run:
            print(f'would run: {shlex.join(args)}')
            return
        logging.debug(args)
        subprocess.run(args, check=check)

    @property
    def update_banner(self) -> str:
        return f'Updating ({self.name})...'

    @property
    def outdated_banner(self) -> str:
        return f'Outdated ({self.name}):'

    @property
    def up_to_date_message(self) -> str:
        return 'Up to date.'

    @property
    def upgrade_prompt(self) -> str:
        return f'Run upgrade ({self.name})? [Y/n]: '

    @property
    def cleanup_banner(self) -> str:
        return f'Running cleanup ({self.name})...'

    def _update(self):
        """Refresh package metadata."""

    def _outdated(self):
        """Show what is out of date."""

    def _upgrade(self):
        """Install what is out of date."""

    def _cleanup(self):
        """Remove what is no longer needed."""

    def _has_step(self, step: str) -> bool:
        """Whether this updater implements `step` (update, outdated, ...)."""

        method = f'_{step}'
        return getattr(type(self), method) is not getattr(Updater, method)

    def _wants_upgrade(self) -> bool:
        """Whether the outdated step found anything worth asking about."""

        return True

    def update(self):
        if not self._has_step('update'):
            return
        print(self.update_banner)
        self._update()
        print()

    def outdated(self):
        if not self._has_step('outdated'):
            return
        print(self.outdated_banner)
        self._outdated()
        print()

    def upgrade(self):
        if not self._has_step('upgrade') or not self._wants_upgrade():
            return
        if confirm(self.upgrade_prompt):
            self._upgrade()
        print()

    def cleanup(self):
        if not self._has_step('cleanup'):
            return
        print(self.cleanup_banner)
        self._cleanup()
        print()

    def run(self, skip_update: bool = False):
        if not self.available():
            # Reached when the user asked for this updater by name; the
            # default set leaves out anything that is not available.
            print(self.outdated_banner)
            print(self.missing_hint())
            print()
            return
        if not skip_update:
            self.update()
        self.outdated()
        self.upgrade()
        self.cleanup()


class CommandBasedUpdater(Updater):
    """An updater driven by plain commands, set as class attributes.

    Each *_cmd is a tuple of arguments; the default `()` means the updater
    has no such step.
    """

    abstract = True

    update_cmd: tuple[str, ...] = ()
    outdated_cmd: tuple[str, ...] = ()
    upgrade_cmd: tuple[str, ...] = ()
    cleanup_cmd: tuple[str, ...] = ()
    # Exit codes of outdated_cmd, besides 0, that are not failures.
    outdated_ok_returncodes: tuple[int, ...] = ()
    # Whether a failing update_cmd stops this updater, or is reported and
    # the rest of its steps still run.
    update_is_fatal: bool = True
    # An executable that must be on PATH for this updater to be available.
    requires: str | None = None

    @staticmethod
    def _run_with_output(args: Sequence[str], allowed_returncodes=()) -> str:
        with (
            subprocess.Popen(
                args,
                stdout=subprocess.PIPE,
                bufsize=1,
                encoding='utf8',
                text=True,
            ) as p,
            StringIO() as buf,
        ):
            for line in cast(TextIO, p.stdout):
                print(line, end='')
                buf.write(line)
            output = buf.getvalue()
            returncode = p.wait()
            if returncode != 0 and returncode not in allowed_returncodes:
                raise subprocess.CalledProcessError(p.returncode, args, output)
            return output

    @classmethod
    def available(cls) -> bool:
        return cls.requires is None or shutil.which(cls.requires) is not None

    def has_updates(self, output: str) -> bool:
        # Override and parse the outdated output to skip upgrade
        return True

    def _has_step(self, step: str) -> bool:
        # A subclass that implements the step itself (PyenvUpdater has no
        # single outdated_cmd to run) always has it; otherwise it has it
        # exactly when there is a command to run.
        method = f'_{step}'
        if getattr(type(self), method) is not getattr(
            CommandBasedUpdater, method
        ):
            return True
        return bool(getattr(self, f'{step}_cmd'))

    def _wants_upgrade(self) -> bool:
        return self.has_updates(self.outdated_output)

    def _update(self):
        try:
            self._run(self.update_cmd)
        except subprocess.CalledProcessError as ex:
            if self.update_is_fatal:
                raise
            print(
                f'{self.name}: update failed ({ex}); continuing',
                file=sys.stderr,
            )

    def _outdated(self):
        self.outdated_output = self._run_with_output(
            self.outdated_cmd, self.outdated_ok_returncodes
        )
        # Otherwise the banner is followed by nothing, which looks broken.
        if not self.has_updates(self.outdated_output):
            print(self.up_to_date_message)

    def _upgrade(self):
        self._run(self.upgrade_cmd)

    def _cleanup(self):
        self._run(self.cleanup_cmd)


class SelfUpdater(CommandBasedUpdater):
    """Fast-forwards the git clone this script runs from, then restarts.

    Only git installs are supported.  The clone must have an upstream branch
    (so a detached HEAD, as in a submodule checkout, does not qualify).  The
    merge is --ff-only, so local changes or commits make it fail instead of
    being overwritten.
    """

    name = 'self'

    @property
    def up_to_date_message(self) -> str:
        return f'update-sw {version()} is up to date.'

    @staticmethod
    def repo_dir() -> Path:
        # Resolved so that a symlink from ~/bin leads back into the clone.
        return Path(__file__).resolve().parent.parent

    def __init__(self):
        repo = str(self.repo_dir())
        self.update_cmd = ('git', '-C', repo, 'fetch', '--quiet', '--tags')
        self.outdated_cmd = (
            'git',
            '-C',
            repo,
            'log',
            '--oneline',
            'HEAD..@{u}',
        )
        self.upgrade_cmd = ('git', '-C', repo, 'merge', '--ff-only', '@{u}')

    def _outdated(self):
        super()._outdated()
        if not self.has_updates(self.outdated_output):
            return
        try:
            print(f'{describe()} -> {describe("@{u}")}')
        except (FileNotFoundError, subprocess.CalledProcessError):
            pass

    @classmethod
    def available(cls) -> bool:
        return command_succeeds(
            'git',
            '-C',
            str(cls.repo_dir()),
            'rev-parse',
            '--abbrev-ref',
            '@{u}',
        )

    @classmethod
    def missing_hint(cls) -> str | None:
        if cls.available():
            return None
        return (
            'update-sw is not running from a git clone with an upstream '
            'branch, so it cannot update itself.'
        )

    def has_updates(self, output: str) -> bool:
        return output.strip() != ''

    def _upgrade(self):
        super()._upgrade()
        if not SETTINGS.dry_run:
            # main() re-executes the script; the rest of this run would
            # otherwise use code that has just been replaced.
            raise Restart()


class BrewUpdater(CommandBasedUpdater):
    name = 'brew'
    update_cmd = ('brew', 'update')
    outdated_cmd = ('brew', 'outdated')
    upgrade_cmd = ('brew', 'upgrade', '--yes')
    cleanup_cmd = ('brew', 'cleanup')

    def __init__(self, fetch_head: bool = True):
        if fetch_head:
            self.outdated_cmd = (*self.outdated_cmd, '--fetch-HEAD')
            self.upgrade_cmd = (*self.upgrade_cmd, '--fetch-HEAD')

    @classmethod
    def applies(cls) -> bool:
        return is_darwin()

    @classmethod
    def from_args(cls, args, config):
        return cls(fetch_head=config_get(config, 'fetch_head', bool, True))

    def has_updates(self, output: str) -> bool:
        return output != ''


class AptUpdater(CommandBasedUpdater):
    name = 'apt'
    update_cmd = ('sudo', '/usr/bin/apt', 'update')
    outdated_cmd = ('/usr/bin/apt', 'list', '--upgradeable')
    upgrade_cmd = ('sudo', '/usr/bin/apt', 'upgrade')
    cleanup_cmd = ('sudo', '/usr/bin/apt', 'autoremove')

    @classmethod
    def applies(cls) -> bool:
        return linux_distro() in ('ubuntu', 'raspbian', 'debian')

    def has_updates(self, output: str) -> bool:
        return output != 'Listing...\n'


class EmergeUpdater(CommandBasedUpdater):
    name = 'emerge'
    update_cmd = ('sudo', '/usr/bin/nice', '/usr/bin/eix-sync')
    upgrade_cmd = (
        'ntfy',
        'done',
        '-L',
        '60',
        'sudo',
        '/usr/bin/nice',
        '/usr/bin/emerge',
        '-avuUD',
        '@world',
    )
    cleanup_cmd = (
        'sudo',
        '/usr/bin/nice',
        '/usr/bin/emerge',
        '-av',
        '--depclean',
    )

    @classmethod
    def applies(cls) -> bool:
        return linux_distro() == 'gentoo'


CPYTHON_RE = re.compile(r'(\d+)\.(\d+)\.(\d+)')
PYPY_RE = re.compile(r'pypy(\d+)(?:\.(\d+))?-(\d+)\.(\d+)\.(\d+)')


@dataclass(frozen=True)
class PyVersion:
    """A pyenv version name split into its implementation and series."""

    name: str
    impl: str  # 'cpython', 'pypy2', 'pypy3', ...
    series: tuple[int, int]  # the (major, minor) Python series, e.g. (3, 13)
    release: tuple[int, ...]  # sorts releases *within* a series

    @property
    def series_name(self) -> str:
        return f'{self.impl} {self.series[0]}.{self.series[1]}'


SeriesKey = tuple[str, tuple[int, int]]


def classify_version(name: str) -> PyVersion | None:
    """Parse a pyenv version name.

    Returns None for anything that is not a plain CPython or PyPy release, so
    aliases, pre-releases (3.14.0rc1), free-threaded builds (3.14.0t), -dev
    branches and anaconda/jython/graalpy entries are all ignored.
    """

    name = name.strip()

    cpython = CPYTHON_RE.fullmatch(name)
    if cpython:
        major, minor, patch = (int(group) for group in cpython.groups())
        return PyVersion(name, 'cpython', (major, minor), (patch,))

    pypy = PYPY_RE.fullmatch(name)
    if pypy:
        major = int(pypy.group(1))
        minor = int(pypy.group(2) or 0)
        # PyPy releases are ordered by their own version, not the Python one.
        release = tuple(int(group) for group in pypy.groups()[2:])
        return PyVersion(name, f'pypy{major}', (major, minor), release)

    return None


def latest_per_series(names: list[str]) -> dict[SeriesKey, PyVersion]:
    """Map each (implementation, series) to its newest release in `names`."""

    latest: dict[SeriesKey, PyVersion] = {}
    for name in names:
        version = classify_version(name)
        if version is None:
            continue
        key = (version.impl, version.series)
        if key not in latest or version.release > latest[key].release:
            latest[key] = version
    return latest


def newest_series_per_impl(
    by_series: dict[SeriesKey, PyVersion],
) -> dict[str, PyVersion]:
    """Map each implementation to its newest *series*, not newest release."""

    newest: dict[str, PyVersion] = {}
    for version in by_series.values():
        current = newest.get(version.impl)
        if current is None or version.series > current.series:
            newest[version.impl] = version
    return newest


def _pyenv_lines(args: tuple[str, ...]) -> list[str]:
    return subprocess.run(
        args, check=True, capture_output=True, encoding='utf8'
    ).stdout.splitlines()


def pyenv_installed_versions() -> list[str]:
    """Every installed version, plus virtualenvs as `<version>/envs/<name>`."""

    return sorted(
        filter(
            None,
            (
                line.strip()
                for line in _pyenv_lines(
                    ('pyenv', 'versions', '--bare', '--skip-aliases')
                )
            ),
        )
    )


class SinglePipUpdater(Updater):
    abstract = True  # Built by PipUpdater, once per environment.

    PIP_SKIP = ('inventory', 'utils')

    def __init__(
        self,
        pip_path: str | Path,
        label: str | None = None,
        skip: Iterable[str] | None = None,
    ):
        resolved = shutil.which(pip_path)
        if resolved is None:
            raise FileNotFoundError(f'no executable pip at {pip_path}')
        self.pip: str = resolved
        # Not a class attribute like every registered updater's name: it says
        # which environment this instance is for.
        self.name = f'pip ({label})' if label else 'pip'
        self.skip = tuple(self.PIP_SKIP if skip is None else skip)
        self._to_update: list[str] = []

    def run(self, skip_update: bool = False):
        owner = Path(self.pip).owner()
        us = getpass.getuser()
        if owner != us:
            print(f'Skipping python (owner: {owner}) that is not ours ({us})')
            return
        super().run(skip_update)

    def _wants_upgrade(self) -> bool:
        return bool(self._to_update)

    def _outdated(self):
        outdated = json.loads(
            subprocess.run(
                (str(self.pip), 'list', '-o', '--format', 'json'),
                check=True,
                stdout=subprocess.PIPE,
                encoding='utf8',
            ).stdout
        )
        to_update = []
        for package in outdated:
            name = package['name']
            if name in self.skip:
                print('Skipping {name}'.format_map(package))
            else:
                to_update.append(
                    (name, package['version'], package['latest_version'])
                )

        if to_update:
            print(
                tabulate(
                    [('Package', 'Version', 'Latest')] + to_update,
                    headers='firstrow',
                )
            )
            self._to_update = [row[0] for row in to_update]

    def _upgrade(self):
        if not self._to_update:
            return
        self._run([self.pip, 'install', '-U'] + self._to_update)
        if SETTINGS.dry_run:
            # Nothing was installed, so `pip check` would only report the
            # state before the upgrade.
            return
        result = subprocess.run(
            (str(self.pip), 'check'),
            stdout=subprocess.PIPE,
            encoding='utf8',
            check=False,
        )
        if result.returncode != 0:
            to_fix = [
                row.split(maxsplit=1)[0] for row in result.stdout.splitlines()
            ]
            print('Fixing broken pip dependencies')
            print(f'{self.pip} install {" ".join(to_fix)}')
            self._run([self.pip, 'install'] + to_fix)


@dataclass(frozen=True)
class PyenvUpgrade:
    """A single pyenv upgrade to offer the user."""

    old: str
    new: str
    # A new series is an *additional* install: `old` only supplies the packages
    # to migrate across and stays installed afterwards.
    new_series: bool = False


class PyenvUpdater(CommandBasedUpdater):
    name = 'pyenv'

    def __init__(self):
        self._upgrades: list[PyenvUpgrade] = []

    @classmethod
    def available(cls) -> bool:
        return command_succeeds('pyenv', '--version')

    @cached_property
    def has_update(self) -> bool:
        """Determines if pyenv update command is available"""
        commands = subprocess.run(
            ('pyenv', 'commands', '-h'),
            check=True,
            capture_output=True,
            encoding='utf8',
        ).stdout
        return 'update' in commands.splitlines()

    @property
    def update_cmd(self) -> tuple[str, ...]:
        if not self.has_update:
            return ()
        return ('pyenv', 'update')

    def _venvs_on(self, base: str) -> list[str]:
        try:
            lines = _pyenv_lines(
                ('pyenv', 'virtualenvs', '--bare', '--skip-aliases')
            )
        except (FileNotFoundError, subprocess.CalledProcessError):
            return []
        prefix = f'{base}/envs/'
        return [
            line.strip()[len(prefix) :]
            for line in lines
            if line.strip().startswith(prefix)
        ]

    @staticmethod
    def _global_version() -> str | None:
        """The first real version in `pyenv global`, if there is one."""

        try:
            lines = _pyenv_lines(('pyenv', 'global'))
        except (FileNotFoundError, subprocess.CalledProcessError):
            return None
        for line in lines:
            name = line.strip()
            if name and name != 'system':
                return name
        return None

    def _migration_source(self, impl: str, newest_installed: PyVersion) -> str:
        """Which version a new-series install should inherit its packages from.

        The current `pyenv global` when it belongs to the same implementation,
        otherwise that implementation's newest installed version -- migrating
        CPython's packages into a PyPy build would not help anyone.
        """

        name = self._global_version()
        if name is not None:
            parsed = classify_version(name)
            if parsed is not None and parsed.impl == impl:
                return name
        return newest_installed.name

    def _outdated(self):
        installed = latest_per_series(pyenv_installed_versions())
        available = latest_per_series(
            _pyenv_lines(('pyenv', 'install', '--list'))
        )

        self._upgrades = []

        # Keep every installed series on the newest release of that series, so
        # a 3.12 stays a 3.12 rather than being dragged onto 3.13.
        for key, current in sorted(installed.items()):
            newest = available.get(key)
            if newest is None:
                continue
            if newest.release > current.release:
                print(
                    f'{current.series_name}: {current.name} -> {newest.name}'
                )
                self._upgrades.append(PyenvUpgrade(current.name, newest.name))
            else:
                print(f'{current.series_name}: {current.name} (up to date)')

        # Separately, offer to *add* a newer series than anything installed.
        newest_installed = newest_series_per_impl(installed)
        for impl, newest in sorted(newest_series_per_impl(available).items()):
            current = newest_installed.get(impl)
            # Only offer series for implementations already in use.
            if current is None or newest.series <= current.series:
                continue
            source = self._migration_source(impl, current)
            print(
                f'{impl}: new series {newest.series_name} available '
                f'({newest.name}, migrating from {source})'
            )
            self._upgrades.append(
                PyenvUpgrade(source, newest.name, new_series=True)
            )

    def _upgrade_one(self, upgrade: PyenvUpgrade):
        if upgrade.new_series:
            prompt = (
                f'Install new series ({self.name}: {upgrade.new}), '
                f'migrating from {upgrade.old}? [Y/n]: '
            )
        else:
            prompt = (
                f'Run upgrade ({self.name}: '
                f'{upgrade.old} -> {upgrade.new})? [Y/n]: '
            )
        if not confirm(prompt):
            return

        cmd = ['update-python']
        # Only a within-series upgrade retires the old version, so only
        # then is it safe to move its virtualenvs across; a new series
        # leaves the old one installed and still in use.
        if not upgrade.new_series:
            venvs = self._venvs_on(upgrade.old)
            if venvs and confirm(
                f'Migrate {len(venvs)} virtualenv(s) on {upgrade.old} '
                f'({", ".join(venvs)}) to {upgrade.new}? [Y/n]: '
            ):
                cmd.append('--migrate-venvs')
        cmd += [upgrade.new, upgrade.old]

        self._run(tuple(cmd))

    def upgrade(self):
        if not self._upgrades:
            return

        # One failed version should not cost the user the others.
        try:
            run_each(self._upgrades, self._upgrade_one, lambda u: u.new)
        finally:
            print()


@dataclass(frozen=True)
class VenvMove:
    """A virtualenv that could be moved onto a newer base Python."""

    name: str
    base: str
    in_series: str | None  # newest installed release of the base's own series
    newer_series: str | None  # newest installed release of a later series


class VenvUpdater(Updater):
    """Moves pyenv virtualenvs that got left behind on an older base Python.

    PyenvUpdater only migrates virtualenvs as a side effect of upgrading the
    version they sit on, so one that was skipped -- or whose base was never
    upgraded -- stays behind indefinitely. This finds those.
    """

    name = 'venv'

    def __init__(self):
        self._moves: list[VenvMove] = []

    @classmethod
    def available(cls) -> bool:
        try:
            commands = _pyenv_lines(('pyenv', 'commands'))
        except (FileNotFoundError, subprocess.CalledProcessError, OSError):
            return False
        return 'virtualenvs' in (command.strip() for command in commands)

    def _outdated(self):
        installed = latest_per_series(
            [
                version
                for version in pyenv_installed_versions()
                if '/envs/' not in version
            ]
        )
        newest_by_impl = newest_series_per_impl(installed)

        self._moves = []
        for line in _pyenv_lines(
            ('pyenv', 'virtualenvs', '--bare', '--skip-aliases')
        ):
            line = line.strip()
            base, sep, name = line.partition('/envs/')
            if not sep or not name:
                continue
            parsed = classify_version(base)
            if parsed is None:
                continue

            in_series = installed.get((parsed.impl, parsed.series))
            newer_series = newest_by_impl.get(parsed.impl)
            move = VenvMove(
                name,
                base,
                in_series.name
                if in_series is not None and in_series.release > parsed.release
                else None,
                newer_series.name
                if newer_series is not None
                and newer_series.series > parsed.series
                else None,
            )
            if move.in_series or move.newer_series:
                print(f'{name}: on {base}')
                self._moves.append(move)

    def _upgrade_one(self, move: VenvMove):
        target = self._choose_target(move)
        if target is None:
            return
        self._run(('update-venv', '--to', target, move.name))

    def upgrade(self):
        if not self._moves:
            return

        # One failed virtualenv should not cost the user the others.
        try:
            run_each(self._moves, self._upgrade_one, lambda m: m.name)
        finally:
            print()

    @staticmethod
    def _choose_target(move: VenvMove) -> str | None:
        """Ask where to move a virtualenv, or None to leave it alone."""

        options = [
            (target, label)
            for target, label in (
                (move.in_series, 'same series'),
                (move.newer_series, 'newest installed'),
            )
            if target is not None
        ]
        if len(options) == 1:
            target, label = options[0]
            if confirm(
                f'Move {move.name} from {move.base} to {target} '
                f'({label})? [Y/n]: '
            ):
                return target
            return None

        print(f'{move.name} is on {move.base}:')
        for number, (target, label) in enumerate(options, start=1):
            print(f'  {number}) {target} ({label})')
        choices = '/'.join(
            str(number) for number in range(1, len(options) + 1)
        )
        prompt = f'Move {move.name}? [{choices}/n]: '
        if SETTINGS.yes:
            # The first option is also what an empty reply picks.
            print(f'{prompt}1')
            return options[0][0]
        reply = input(prompt).strip()
        if reply in ('N', 'n'):
            return None
        if not reply:
            return options[0][0]
        if reply.isdigit() and 1 <= int(reply) <= len(options):
            return options[int(reply) - 1][0]
        print(f'Skipping {move.name}: "{reply}" is not one of {choices}')
        return None


class PipUpdater(Updater):
    """Runs the pip updater against every pyenv environment we own."""

    name = 'pip'

    def __init__(
        self,
        pip_bin: str | None = None,
        skip: Iterable[str] | None = None,
    ):
        self.pip_bin = pip_bin
        self.skip = skip

    @classmethod
    def from_args(cls, args, config):
        skip = config_get(config, 'skip', list, None)
        return cls(args.pip_bin, skip=skip)

    def _target_pips(self) -> list[tuple[str, str | None]]:
        if self.pip_bin:
            return [(self.pip_bin, None)]

        if PyenvUpdater.available():
            root = subprocess.run(
                ('pyenv', 'root'),
                check=True,
                capture_output=True,
                encoding='utf8',
            ).stdout.strip()
            # Every installed version and virtualenv, not just the newest of
            # each series: whichever one is active still wants its packages
            # kept current. SinglePipUpdater skips any we do not own.
            targets = []
            for version in pyenv_installed_versions():
                path = f'{root}/versions/{version}/bin/pip'
                if os.access(path, os.X_OK):
                    targets.append((path, version))
            return targets

        return [('pip3', None)]

    def run(self, skip_update: bool = False):
        targets = self._target_pips()
        if not targets:
            print('No pip targets found')
            return

        # Keep going: one broken environment -- a pip too old to speak
        # `--format json`, a half-removed prefix -- should not cost the
        # user every other environment queued behind it.
        run_each(
            targets,
            lambda target: SinglePipUpdater(
                target[0], target[1], self.skip
            ).run(skip_update),
            lambda target: target[1] or target[0],
            catch=(
                subprocess.CalledProcessError,
                json.JSONDecodeError,
                OSError,
            ),
        )


class MacOsUpdater(CommandBasedUpdater):
    name = 'macos'
    outdated_cmd = ('softwareupdate', '--list')
    upgrade_cmd = ('sudo', 'softwareupdate', '--install', '--all', '--restart')

    @classmethod
    def applies(cls) -> bool:
        return is_darwin()

    def has_updates(self, output: str) -> bool:
        # Modern softwareupdate writes "Finding available software" and "No
        # new software available." to stderr, so stdout is empty when there
        # is nothing.  Updates are listed as lines starting with `*`.
        return any(
            line.lstrip().startswith('*') for line in output.splitlines()
        )


class MasUpdater(CommandBasedUpdater):
    """Updates Mac App Store apps with the `mas` command line tool."""

    name = 'mas'
    requires = 'mas'
    # `mas outdated` queries the App Store itself, so there is no update_cmd.
    # --accurate is slower, but the default check misses some updates.
    outdated_cmd = ('mas', 'outdated', '--accurate')
    # mas needs root to install app updates.
    upgrade_cmd = ('sudo', 'mas', 'upgrade', '--accurate')

    @classmethod
    def applies(cls) -> bool:
        return is_darwin()

    @classmethod
    def missing_hint(cls) -> str | None:
        if cls.available():
            return None
        return 'mas is not installed.\nInstall it with: brew install mas'

    def has_updates(self, output: str) -> bool:
        return output.strip() != ''


class RustupUpdater(CommandBasedUpdater):
    name = 'rustup'
    # Self update is disabled in package-manager builds and may fail
    # transiently; neither should block the toolchain update.
    update_cmd = ('rustup', 'self', 'update')
    update_is_fatal = False
    outdated_cmd = ('rustup', 'check')
    # `rustup check` exits 100 when an update is available.
    outdated_ok_returncodes = (100,)
    # Self update was already attempted (or skipped via --skip-update)
    # in the update step, so don't try it again.
    upgrade_cmd = ('rustup', 'update', '--no-self-update')

    @classmethod
    def available(cls) -> bool:
        return command_succeeds('rustup', '--version')

    def has_updates(self, output: str) -> bool:
        return re.search('Update available', output, re.IGNORECASE) is not None


class CargoUpdater(CommandBasedUpdater):
    """Updates the binaries installed with `cargo install`.

    cargo can list what is installed but has no notion of what is stale, so
    both halves of this are left to cargo-update, the subcommand that exists
    for exactly that.
    """

    name = 'cargo'
    # `install-update --list` polls the registry itself, so there is no
    # update_cmd.
    outdated_cmd = ('cargo', 'install-update', '--list', '--all')
    upgrade_cmd = ('cargo', 'install-update', '--all')

    def __init__(self, git: bool = True):
        # cargo-update leaves --git off by default because re-fetching every
        # git package is slow, but without it those packages are never
        # reported and so never updated -- the same trade brew makes here
        # with --fetch-HEAD.
        if git:
            self.outdated_cmd = (*self.outdated_cmd, '--git')
            self.upgrade_cmd = (*self.upgrade_cmd, '--git')

    @classmethod
    def from_args(cls, args, config):
        return cls(git=config_get(config, 'git', bool, True))

    @staticmethod
    def cargo_bin_dir() -> Path:
        cargo_home = os.environ.get('CARGO_HOME')
        root = Path(cargo_home) if cargo_home else Path.home() / '.cargo'
        return root / 'bin'

    @staticmethod
    def has_cargo() -> bool:
        return shutil.which('cargo') is not None

    @classmethod
    def has_cargo_update(cls) -> bool:
        # Resolved the way cargo resolves its own subcommands: PATH first,
        # then $CARGO_HOME/bin, which is not always on PATH.
        if shutil.which('cargo-install-update') is not None:
            return True
        binary = cls.cargo_bin_dir() / 'cargo-install-update'
        return os.access(binary, os.X_OK)

    @classmethod
    def available(cls) -> bool:
        # Only worth queueing if cargo-update can do the check.
        return cls.has_cargo_update()

    @classmethod
    def missing_hint(cls) -> str | None:
        """Say what to install, or None if this updater can run."""

        if not cls.has_cargo():
            return 'cargo is not installed; nothing to update.'
        if not cls.has_cargo_update():
            return (
                'cargo-update is not installed, so installed binaries '
                'cannot be checked.\n'
                'Install it with: cargo install cargo-update'
            )
        return None

    def has_updates(self, output: str) -> bool:
        # Every package row ends in Yes or No, and the table header's last
        # field is 'update', so matching the final field is enough.
        return any(
            fields[-1] == 'Yes'
            for fields in (line.split() for line in output.splitlines())
            if fields
        )


class ExplorerUpdater(Updater):
    """Base for Windows updaters that just open a settings pane via explorer.exe."""

    abstract = True

    uri: str

    @classmethod
    def applies(cls) -> bool:
        return is_wsl()

    def _update(self):
        self._run(['explorer.exe', self.uri], check=False)


class WindowsUpdateUpdater(ExplorerUpdater):
    name = 'windows-update'
    uri = 'ms-settings:windowsupdate'


class WindowsStoreUpdater(ExplorerUpdater):
    name = 'windows-store'
    uri = 'ms-windows-store:'


class ConfigError(Exception):
    """The config file could not be used."""


def config_home() -> Path:
    """The directory holding update-sw's config file and plugins."""

    xdg = os.environ.get('XDG_CONFIG_HOME')
    return (Path(xdg) if xdg else Path.home() / '.config') / 'update-sw'


def load_config(path: Path | None = None) -> dict[str, Any]:
    """Read the TOML config, or return {} if there is none to read."""

    explicit = path is not None
    if path is None:
        path = config_home() / 'config.toml'
    if not path.is_file():
        if explicit:
            raise ConfigError(f'{path}: no such file')
        return {}
    if tomllib is None:
        print(
            f'{path}: ignoring config, this Python has no tomllib (3.11+)',
            file=sys.stderr,
        )
        return {}
    # A config that does not parse is an error, not a reason to carry on with
    # the defaults: it may be what keeps an updater from running.
    try:
        with path.open('rb') as f:
            return tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError) as ex:
        raise ConfigError(f'{path}: {ex}') from ex


def config_get(section: dict[str, Any], key: str, kind: type, default):
    """Get section[key] if it is a `kind`, warning and defaulting if not."""

    if key not in section:
        return default
    value = section[key]
    if not isinstance(value, kind):
        print(
            f'config: {key} should be a {kind.__name__}, ignoring {value!r}',
            file=sys.stderr,
        )
        return default
    return value


def make_command_updater(name: str, spec: dict[str, Any]) -> type[Updater]:
    """Build (and so register) a CommandBasedUpdater subclass from data.

    `spec` has the keys of a [updaters.NAME] config table.  Raises TypeError
    if it is malformed and ValueError if `name` is taken.
    """

    known = {
        'update',
        'outdated',
        'upgrade',
        'cleanup',
        'no_updates_output',
        'requires',
        'default',
        'outdated_ok_returncodes',
        'update_is_fatal',
    }
    for key in sorted(set(spec) - known):
        print(
            f'config: updater {name!r}: unknown key {key!r}', file=sys.stderr
        )

    def strings(key: str) -> tuple[str, ...]:
        value = spec.get(key, ())
        if not isinstance(value, (list, tuple)) or not all(
            isinstance(item, str) for item in value
        ):
            raise TypeError(f'{key} must be a list of strings')
        return tuple(value)

    def typed(key: str, kind: type, default):
        value = spec.get(key, default)
        if not isinstance(value, kind):
            raise TypeError(f'{key} must be a {kind.__name__}')
        return value

    attrs: dict[str, Any] = {
        'name': name,
        'update_cmd': strings('update'),
        'outdated_cmd': strings('outdated'),
        'upgrade_cmd': strings('upgrade'),
        'cleanup_cmd': strings('cleanup'),
        'update_is_fatal': typed('update_is_fatal', bool, True),
        # Unlike built-ins, only part of the default set when asked to be.
        'default': typed('default', bool, False),
    }
    returncodes = spec.get('outdated_ok_returncodes', ())
    if not isinstance(returncodes, (list, tuple)) or not all(
        isinstance(code, int) for code in returncodes
    ):
        raise TypeError('outdated_ok_returncodes must be a list of integers')
    attrs['outdated_ok_returncodes'] = tuple(returncodes)
    requires = spec.get('requires')
    if requires is not None:
        attrs['requires'] = typed('requires', str, None)

    if attrs['outdated_cmd']:
        no_updates = typed('no_updates_output', str, '').strip()

        def has_updates(self, output: str) -> bool:
            return output.strip() != no_updates

        attrs['has_updates'] = has_updates

    class_name = re.sub(r'\W', '_', name) + 'Updater'
    return type(class_name, (CommandBasedUpdater,), attrs)


def register_config_updaters(config: dict[str, Any]) -> None:
    """Create the updaters defined under [updaters] in the config."""

    section = config.get('updaters', {})
    if not isinstance(section, dict):
        print('config: updaters should be a table, ignoring', file=sys.stderr)
        return
    for name, spec in section.items():
        if name in REGISTRY:
            print(
                f'config: updater {name!r} collides with a built-in '
                'updater, skipping',
                file=sys.stderr,
            )
            continue
        if not isinstance(spec, dict):
            print(
                f'config: updater {name!r} should be a table, skipping',
                file=sys.stderr,
            )
            continue
        try:
            make_command_updater(name, spec)
        except (TypeError, ValueError) as ex:
            print(f'config: updater {name!r}: {ex}, skipping', file=sys.stderr)


def load_plugins(directory: Path | None = None) -> None:
    """Import every *.py in the updaters directory, so they can register."""

    if directory is None:
        directory = config_home() / 'updaters'
    if not directory.is_dir():
        return
    # Plugins import this script by this name; see the module docstring.
    sys.modules['update_sw'] = sys.modules[__name__]
    for path in sorted(directory.glob('*.py')):
        try:
            spec = importlib.util.spec_from_file_location(
                f'update_sw_plugin_{path.stem}', path
            )
            if spec is None or spec.loader is None:
                raise ImportError('not a python module')
            spec.loader.exec_module(importlib.util.module_from_spec(spec))
        except Exception as ex:  # noqa: BLE001 -- must not stop the rest
            print(f'{path}: failed to load plugin: {ex!r}', file=sys.stderr)


def known_names(names: Iterable[str], source: str) -> list[str]:
    """Drop (with a warning) names that are not registered updaters."""

    known = []
    for name in names:
        if name in REGISTRY:
            known.append(name)
        else:
            print(
                f'{source}: unknown updater {name!r}, ignoring',
                file=sys.stderr,
            )
    return known


def config_names(config: dict[str, Any], key: str) -> list[str]:
    """The known updater names listed under `key` in the config."""

    names = config_get(config, key, list, [])
    if not all(isinstance(name, str) for name in names):
        print(
            f'config: {key} should be a list of names, ignoring',
            file=sys.stderr,
        )
        return []
    return known_names(names, f'config: {key}')


def default_updaters(config: dict[str, Any] | None = None) -> list[str]:
    """Compute the ordered list of updater names to run by default.

    That is every updater in ORDER (then any others that were registered)
    that applies here and is available, adjusted by the config.
    """

    config = config or {}

    names: list[str]
    if 'default' in config:
        names = config_names(config, 'default')
    else:
        names = [
            name
            for name in list_names()
            if REGISTRY[name].default
            and REGISTRY[name].applies()
            and REGISTRY[name].available()
        ]

    extra = [n for n in config_names(config, 'extra') if n not in names]
    if 'default' in config:
        # The list was spelled out, so leave its order alone.
        names += extra
    else:
        # A known name goes where ORDER says; the sort is stable, so the
        # rest stay behind in the order they came.
        names = sorted(
            names + extra,
            key=lambda n: ORDER.index(n) if n in ORDER else len(ORDER),
        )

    excluded = set(config_names(config, 'exclude'))
    return [name for name in names if name not in excluded]


def main(argv: Sequence[str] | None = None):
    args_list = list(argv if argv is not None else sys.argv[1:])
    args = parse_args(args_list)
    configure_logging(args)
    # Popped so that it reaches neither child processes nor a later run.
    restarted = os.environ.pop('UPDATE_SW_RESTARTED', None) is not None
    SETTINGS.yes = args.yes
    SETTINGS.dry_run = args.dry_run

    try:
        config = load_config(args.config)
    except ConfigError as ex:
        print(f'Bad config: {ex}', file=sys.stderr)
        return 2
    register_config_updaters(config)
    load_plugins()

    excluded = set(known_names(args.exclude, '--exclude'))

    if args.list:
        defaults = set(default_updaters(config)) - excluded
        for updater_name in list_names():
            marker = '*' if updater_name in defaults else ' '
            print(f'{marker} {updater_name}')
        print('\n* runs by default on this platform')
        return 0

    if args.updaters:
        unknown = [n for n in args.updaters if n not in REGISTRY]
        if unknown:
            print(
                f'Unknown updater(s): {", ".join(unknown)}',
                file=sys.stderr,
            )
            print(
                f'Valid updaters: {", ".join(list_names())}',
                file=sys.stderr,
            )
            return 2
        selected = args.updaters
    else:
        selected = default_updaters(config)
    selected = [name for name in selected if name not in excluded]
    if restarted:
        # Already updated, and this is the new code.
        selected = [name for name in selected if name != 'self']
    elif 'self' in selected:
        # Config `default` can reorder, but a restart re-runs whatever ran
        # before self, so it has to go first.
        selected = ['self'] + [name for name in selected if name != 'self']

    # A failing updater should not cost the user every updater queued behind
    # it; report at the end and exit non-zero instead.
    failures: list[tuple[str, int]] = []
    for updater_name in selected:
        section = config.get(updater_name)
        try:
            REGISTRY[updater_name].from_args(
                args, section if isinstance(section, dict) else {}
            ).run(skip_update=args.skip_update)
        except Restart:
            print('Restarting update-sw on the new version...', flush=True)
            os.execve(
                sys.executable,
                [sys.executable, str(Path(__file__).resolve()), *args_list],
                {**os.environ, 'UPDATE_SW_RESTARTED': '1'},
            )
        except subprocess.CalledProcessError as ex:
            print(f'{updater_name}: {ex}', file=sys.stderr)
            failures.append((updater_name, ex.returncode or 1))
        except UpdaterError as ex:
            print(f'{updater_name}: {ex}', file=sys.stderr)
            failures.append((updater_name, 1))
        except OSError as ex:
            print(f'{updater_name}: {ex}', file=sys.stderr)
            failures.append((updater_name, 1))

    if failures:
        print(
            'Failed updaters: ' + ', '.join(name for name, _ in failures),
            file=sys.stderr,
        )
        return failures[0][1]

    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(1)
    except EOFError:
        # Nothing on stdin to answer a prompt with: bail out rather than
        # tracebacking out of a non-interactive run.
        print('No input available for prompt; stopping.', file=sys.stderr)
        sys.exit(1)
